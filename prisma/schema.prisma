generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  PENDING
  EXTRACTING
  EXTRACTED
  ANALYZING
  ANALYZED
  SPECCING
  SPECCED
  GENERATING
  COMPLETED
  FAILED
}

enum ViewportType {
  DESKTOP
  MOBILE
  TABLET
}

enum CodeFormat {
  HTML
  REACT
  VUE
}

model Project {
  id             String        @id @default(cuid())
  name           String
  url            String
  status         ProjectStatus @default(PENDING)
  componentQuery String?
  viewport       ViewportType  @default(DESKTOP)
  screenshotUrl  String?
  rawHtml        String?
  pageTitle      String?
  error          String?
  pipelineLogs  String?
  pageCss        String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  components     ExtractedComponent[]
  tokens         DesignToken[]
}

model ExtractedComponent {
  id            String      @id @default(cuid())
  projectId     String
  name          String
  tag           String?
  html          String
  cssClasses    String?
  inlineStyles  String?
  spec          String?
  generatedCode String?
  codeFormat    CodeFormat  @default(HTML)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  references    Reference[]
}

model DesignToken {
  id          String   @id @default(cuid())
  projectId   String
  category    String
  name        String
  value       String
  originalVar String?
  createdAt   DateTime @default(now())

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Reference {
  id          String   @id @default(cuid())
  name        String
  description String?
  sourceUrl   String?
  componentId String?
  html        String
  css         String?
  spec        String?
  tags        String   @default("[]")
  thumbnail   String?
  isFavorite  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  component   ExtractedComponent? @relation(fields: [componentId], references: [id])
}
